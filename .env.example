# Контракт конфігурації. Живе в git. Після клону: cp .env.example .env

# HTTP-порт. Zod coerce з рядка env у number, 1024–65535.
PORT=3000

# URL Postgres (host/user/db). Пароль у рядку фейковий — пул читає secrets/db_password.
DB_URL=postgres://app_user:CHANGE_ME@127.0.0.1:6432/marketplace

# Рівень логування: debug | info | warn | error. Опціональна, дефолт info.
LOG_LEVEL=info

# RabbitMQ AMQP (порт 5672, не 15672 management UI). Живе значення — у сховищі ДЗ#11.
BROKER_URL=amqp://app:app@127.0.0.1:5672

# ДЗ#23: два Redis (живуть у сховищі ДЗ#11, не в .env).
# Кеш: allkeys-lru + maxmemory. Черга/сесії/ліміт: noeviction.
REDIS_URL=redis://127.0.0.1:16379
REDIS_QUEUE_URL=redis://127.0.0.1:16380
