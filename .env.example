# Контракт конфігурації. Живе в git. Після клону: cp .env.example .env

# HTTP-порт. Zod coerce з рядка env у number, 1024–65535.
PORT=3000

# URL Postgres (host/user/db). Пароль у рядку фейковий — пул читає secrets/db_password.
DB_URL=postgres://app_user:CHANGE_ME@127.0.0.1:5432/marketplace

# Рівень логування: debug | info | warn | error. Опціональна, дефолт info.
LOG_LEVEL=info
